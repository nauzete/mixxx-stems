<Template>
  <WidgetGroup>
    <ObjectName>Topbar</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,54max</Size>
    <Children>

      <!-- Línea de estado superior muy fina -->
      <WidgetGroup>
        <ObjectName>TopStatusBar</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,12max</Size>
        <Children>
          <Label><ObjectName>TopUtilityLabel</ObjectName><Text>— UTILITY</Text><Size>0me,12max</Size></Label>
        </Children>
      </WidgetGroup>

      <!-- TABS centrados con margen arriba 4px y abajo 4px -->
      <WidgetGroup>
        <ObjectName>TabControls</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,42max</Size>
        <Children>

          <!-- Flex spacer izquierdo — empuja tabs al centro -->
          <Label><Size>0me,42max</Size></Label>

          <!-- MIXING -->
          <PushButton>
            <ObjectName>TabButtonOverview</ObjectName>
            <Size>132max,32max</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>MIXING</Text></State>
            <State><Number>1</Number><Text>MIXING</Text></State>
            <Connection>
              <ConfigKey>[Tab],overview</ConfigKey>
            </Connection>
          </PushButton>

          <Label><Size>12max,42max</Size></Label>

          <!-- BROWSE -->
          <PushButton>
            <ObjectName>TabButtonBrowse</ObjectName>
            <Size>132max,32max</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>BROWSE</Text></State>
            <State><Number>1</Number><Text>BROWSE</Text></State>
            <Connection>
              <ConfigKey>[Tab],library</ConfigKey>
            </Connection>
          </PushButton>

          <Label><Size>12max,42max</Size></Label>

          <!-- SAMPLERS -->
          <PushButton>
            <ObjectName>TabButtonSamplers</ObjectName>
            <Size>132max,32max</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>SAMPLERS</Text></State>
            <State><Number>1</Number><Text>SAMPLERS</Text></State>
            <Connection>
              <ConfigKey>[Tab],samplers</ConfigKey>
            </Connection>
          </PushButton>

          <Label><Size>12max,42max</Size></Label>

          <!-- STEMS -->
          <WidgetGroup>
            <ObjectName>StemActiveModeGroup</ObjectName>
            <Layout>vertical</Layout>
            <Size>118max,38max</Size>
            <Children>
              <Label><ObjectName>StemActiveModeLabel</ObjectName><Text>ACTIVE STEM</Text><Size>0me,13max</Size></Label>
              <PushButton>
                <ObjectName>StemActiveModeButton</ObjectName>
                <Size>0me,25max</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>MUTE</Text></State>
                <State><Number>1</Number><Text>SOLO</Text></State>
                <Connection>
                  <ConfigKey>[StemSeparation],active_mode</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>StemThreadsGroup</ObjectName>
            <Layout>vertical</Layout>
            <Size>96max,38max</Size>
            <Children>
              <Label><ObjectName>StemThreadsLabel</ObjectName><Text>ONNX THREADS</Text><Size>0me,13max</Size></Label>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,25max</Size>
                <Children>
                  <PushButton>
                    <ObjectName>StemThreadsButton</ObjectName>
                    <Size>28max,25max</Size><NumberStates>1</NumberStates>
                    <State><Number>0</Number><Text>-</Text></State>
                    <Connection><ConfigKey>[StemSeparation],inference_threads_down</ConfigKey></Connection>
                  </PushButton>
                  <NumberPos>
                    <ObjectName>StemThreadsValue</ObjectName>
                    <Size>38max,25max</Size><NumberOfDigits>2</NumberOfDigits>
                    <Connection><ConfigKey>[StemSeparation],inference_threads</ConfigKey></Connection>
                  </NumberPos>
                  <PushButton>
                    <ObjectName>StemThreadsButton</ObjectName>
                    <Size>28max,25max</Size><NumberStates>1</NumberStates>
                    <State><Number>0</Number><Text>+</Text></State>
                    <Connection><ConfigKey>[StemSeparation],inference_threads_up</ConfigKey></Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <!-- Flex spacer derecho — equilibra el centrado -->
          <Label><Size>0me,42max</Size></Label>

        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
