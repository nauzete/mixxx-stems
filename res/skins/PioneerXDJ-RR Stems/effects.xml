<Template>
  <WidgetGroup>
    <ObjectName>BeatFX_Container</ObjectName>
    <Layout>vertical</Layout>
    <Size>150max,0me</Size>
    <Children>

      <!-- Header con título y VU master (igual Pioneered) -->
      <WidgetGroup>
        <ObjectName>BeatFX_Header</ObjectName>
        <Layout>vertical</Layout>
        <Size>20me,16p</Size>
        <Children>
          <Label>
            <ObjectName>BeatFX_Title</ObjectName>
            <Text>Beat FX</Text>
          </Label>
          <VuMeter>
            <ObjectName>EffectMeter</ObjectName>
            <Size>0me,6max</Size>
            <PathBack scalemode="STRETCH">icons/effect_meter_bg.png</PathBack>
            <PathVu scalemode="STRETCH">icons/effect_meter_fg.png</PathVu>
            <Horizontal>true</Horizontal>
            <PeakHoldSize>0</PeakHoldSize>
            <PeakHoldTime>0</PeakHoldTime>
            <PeakFallTime>0</PeakFallTime>
            <PeakFallStep>0</PeakFallStep>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1],mix</ConfigKey>
            </Connection>
          </VuMeter>
        </Children>
      </WidgetGroup>

      <!-- 3 slots de efectos -->
      <Template src="skin:effect.xml">
        <SetVariable name="rack">1</SetVariable>
        <SetVariable name="unit">1</SetVariable>
        <SetVariable name="effect">1</SetVariable>
      </Template>
      <Template src="skin:effect.xml">
        <SetVariable name="rack">1</SetVariable>
        <SetVariable name="unit">1</SetVariable>
        <SetVariable name="effect">2</SetVariable>
      </Template>
      <Template src="skin:effect.xml">
        <SetVariable name="rack">1</SetVariable>
        <SetVariable name="unit">1</SetVariable>
        <SetVariable name="effect">3</SetVariable>
      </Template>

      <!-- CH SELECT -->
      <Label>
        <ObjectName>BeatFX_ChSelectLabel</ObjectName>
        <Text>CH SELECT</Text>
        <Size>0me,14max</Size>
      </Label>
      <WidgetGroup>
        <ObjectName>BeatFX_ChSelect</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,26max</Size>
        <Children>
          <PushButton>
            <ObjectName>BeatFX_Ch1</ObjectName><Size>0me,26max</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>CH1</Text></State>
            <State><Number>1</Number><Text>CH1</Text></State>
            <Connection><ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey></Connection>
          </PushButton>
          <PushButton>
            <ObjectName>BeatFX_ChMaster</ObjectName><Size>0me,26max</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>MST</Text></State>
            <State><Number>1</Number><Text>MST</Text></State>
            <Connection><ConfigKey>[EffectRack1_EffectUnit1],group_[Master]_enable</ConfigKey></Connection>
          </PushButton>
          <PushButton>
            <ObjectName>BeatFX_Ch2</ObjectName><Size>0me,26max</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>CH2</Text></State>
            <State><Number>1</Number><Text>CH2</Text></State>
            <Connection><ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey></Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
