<Template>
  <WidgetGroup>
    <ObjectName>Deck</ObjectName>
    <Layout>vertical</Layout>
    <Children>

      <!-- ── TÍTULO pista ─────────────────────────────── -->
      <WidgetGroup>
        <ObjectName>DeckHeader</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,22max</Size>
        <Children>
          <Label><ObjectName>DeckTitleNote</ObjectName><Text>&#9834;</Text><Size>18f,22max</Size></Label>
          <TrackProperty>
            <ObjectName>DeckTitle</ObjectName>
            <TooltipId>track_title</TooltipId>
            <SizePolicy>me,e</SizePolicy>
            <Property>title</Property>
            <Channel><Variable name="channel"/></Channel>
            <Elide>right</Elide>
          </TrackProperty>
        </Children>
      </WidgetGroup>

      <!-- ── FILA INFO + OVERVIEW ──────────────────────── -->
      <WidgetGroup>
        <ObjectName>DeckInfo</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,80max</Size>
        <Children>

          <!-- Columna izquierda: Deck label + Track + Cue buttons -->
          <WidgetGroup>
            <ObjectName>DeckTrackNumberContainer</ObjectName>
            <Layout>vertical</Layout>
            <Size>90f,0me</Size>
            <Children>
              <WidgetGroup>
                <ObjectName>DeckChannelTitleWrapper</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,22max</Size>
                <Children>
                  <Label>
                    <ObjectName>DeckPlayingLeft</ObjectName><Text>&#9654;</Text><Size>14f,22max</Size>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],play</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Label>
                  <Label><ObjectName>DeckChannelTitle</ObjectName><Text>DECK <Variable name="channel"/></Text><Size>0me,22max</Size></Label>
                </Children>
              </WidgetGroup>
              <Label><ObjectName>TrackNumberTitle</ObjectName><Text>TRACK</Text><Size>0me,14max</Size></Label>
              <WidgetGroup>
                <ObjectName>TrackNumberWrapper</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,20max</Size>
                <Children>
                  <TrackProperty>
                    <ObjectName>TrackNumber</ObjectName>
                    <TooltipId>track_number</TooltipId>
                    <Property>track_number</Property>
                    <Channel><Variable name="channel"/></Channel>
                    <Elide>right</Elide>
                  </TrackProperty>
                </Children>
              </WidgetGroup>
              <PushButton>
                <ObjectName>HotCueActivate</ObjectName>
                <TooltipId>hotcue_activate</TooltipId>
                <Size>0me,22max</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>A.HOT CUE</Text></State>
                <State><Number>1</Number><Text>A.HOT CUE</Text></State>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel"/>],hotcue_1_enabled</ConfigKey>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>AutoCueButton</ObjectName>
                <TooltipId>cue_default</TooltipId>
                <Size>0me,22max</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>AUTO CUE</Text></State>
                <State><Number>1</Number><Text>AUTO CUE</Text></State>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel"/>],cue_default</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>

          <!-- Mini waveform Overview -->
          <Overview>
            <ObjectName>DeckOverview</ObjectName>
            <Size>0me,0me</Size>
            <Channel><Variable name="channel"/></Channel>
            <BgColor>#000000</BgColor>
            <SignalColor>#111118</SignalColor>
            <SignalLowColor>#0066ff</SignalLowColor>
            <SignalMidColor>#ff2244</SignalMidColor>
            <SignalHighColor>#ff88cc</SignalHighColor>
            <PlayedOverlayColor>#28ffffff</PlayedOverlayColor>
            <Mark><Control>cue_point</Control><Color>#ff8800</Color><TextColor>#ff8800</TextColor><Text>CUE</Text></Mark>
            <Mark><Control>hotcue_1_position</Control><Text>A</Text><Color>#f44040</Color><TextColor>#f44040</TextColor></Mark>
            <Mark><Control>hotcue_2_position</Control><Text>B</Text><Color>#0ddcf2</Color><TextColor>#0ddcf2</TextColor></Mark>
            <Mark><Control>hotcue_3_position</Control><Text>C</Text><Color>#a5df13</Color><TextColor>#a5df13</TextColor></Mark>
            <Mark><Control>hotcue_4_position</Control><Text>D</Text><Color>#9d4cfd</Color><TextColor>#9d4cfd</TextColor></Mark>
            <Mark><Control>hotcue_5_position</Control><Text>E</Text><Color>#3fec2b</Color><TextColor>#3fec2b</TextColor></Mark>
            <Mark><Control>hotcue_6_position</Control><Text>F</Text><Color>#e6681c</Color><TextColor>#e6681c</TextColor></Mark>
            <Mark><Control>hotcue_7_position</Control><Text>G</Text><Color>#2749c8</Color><TextColor>#2749c8</TextColor></Mark>
            <Mark><Control>hotcue_8_position</Control><Text>H</Text><Color>#c7b205</Color><TextColor>#c7b205</TextColor></Mark>
            <Mark><Control>loop_start_position</Control><Color>#6ee128</Color></Mark>
            <Mark><Control>loop_end_position</Control><Color>#6ee128</Color></Mark>
            <MarkRange>
              <StartControl>loop_start_position</StartControl>
              <EndControl>loop_end_position</EndControl>
              <EnabledControl>loop_enabled</EnabledControl>
              <Color>#6ee128</Color><Opacity>0.4</Opacity>
              <DisabledColor>#acacac</DisabledColor><DisabledOpacity>0.15</DisabledOpacity>
            </MarkRange>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel"/>],playposition</ConfigKey>
            </Connection>
          </Overview>

          <!-- Tempo % -->
          <WidgetGroup>
            <ObjectName>TrackBPMRangeContainer</ObjectName>
            <Layout>vertical</Layout>
            <Size>60f,0me</Size>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,18max</Size>
                <Children>
                  <Label><ObjectName>BPMRangePlusMinus</ObjectName><Text>&#177;</Text></Label>
                  <RateRange>
                    <ObjectName>RateDisplay</ObjectName>
                    <TooltipId>rate_range_display</TooltipId>
                    <Channel><Variable name="channel"/></Channel>
                    <Display>range</Display>
                  </RateRange>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,0me</Size>
                <Children>
                  <NumberRate>
                    <TooltipId>rate_display</TooltipId>
                    <Channel><Variable name="channel"/></Channel>
                    <NumberOfDigits>1</NumberOfDigits>
                  </NumberRate>
                  <Label><ObjectName>BPMPercent</ObjectName><Text>%</Text></Label>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <!-- BPM box -->
          <WidgetGroup>
            <ObjectName>TrackBPMContainer</ObjectName>
            <Layout>vertical</Layout>
            <Size>72f,0me</Size>
            <Children>
              <Label><ObjectName>DeckTempoTitle</ObjectName><Text>BPM</Text><Size>0me,16max</Size></Label>
              <WidgetGroup>
                <ObjectName>DeckBPMWrapper</ObjectName>
                <Layout>vertical</Layout>
                <Size>0me,0me</Size>
                <Children>
                  <NumberBpm>
                    <ObjectName>DeckBPM</ObjectName>
                    <TooltipId>visual_bpm</TooltipId>
                    <Channel><Variable name="channel"/></Channel>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],visual_bpm</ConfigKey>
                    </Connection>
                  </NumberBpm>
                  <Label><ObjectName>DeckBPMTitle</ObjectName><Text>BPM</Text></Label>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

        </Children>
      </WidgetGroup>

      <!-- ── TIEMPO GRANDE ─────────────────────────────── -->
      <WidgetGroup>
        <ObjectName>DeckTimeRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,42max</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>RemainLabelGroup</ObjectName>
            <Layout>vertical</Layout>
            <Size>68f,0me</Size>
            <Children>
              <Label><ObjectName>RemainStaticLabel</ObjectName><Text>REMAIN</Text><Size>0me,22max</Size></Label>
              <Label><ObjectName>ElapsedStaticLabel</ObjectName><Text>ELAPSED</Text><Size>0me,18max</Size></Label>
            </Children>
          </WidgetGroup>
          <NumberPos>
            <ObjectName>DeckTrackTime</ObjectName>
            <TooltipId>track_time</TooltipId>
            <NumberOfDigits>6</NumberOfDigits>
            <Channel><Variable name="channel"/></Channel>
            <Size>0me,42max</Size>
            <Connection>
              <ConfigKey>[Controls],ShowDurationRemaining</ConfigKey>
              <Transform><IsEqual>2</IsEqual></Transform>
              <BindProperty>highlight</BindProperty>
            </Connection>
          </NumberPos>
        </Children>
      </WidgetGroup>

      <!-- ── TRANSPORTE — todos los botones con 0me para distribuirse ── -->
      <WidgetGroup>
        <ObjectName>DeckTransport</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,40max</Size>
        <Children>

          <!-- SYNC -->
          <PushButton>
            <ObjectName>SyncButton</ObjectName><TooltipId>sync_enabled</TooltipId>
            <Size>0me,34max</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>SYNC</Text></State>
            <State><Number>1</Number><Text>SYNC</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="channel"/>],sync_enabled</ConfigKey></Connection>
          </PushButton>
          <Label><Size>3max,34max</Size></Label>
          <!-- CUE -->
          <PushButton>
            <ObjectName>CueButton</ObjectName><TooltipId>cue_default</TooltipId>
            <Size>0me,34max</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>CUE</Text></State>
            <State><Number>1</Number><Text>CUE</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="channel"/>],cue_default</ConfigKey></Connection>
          </PushButton>
          <Label><Size>3max,34max</Size></Label>
          <!-- PLAY -->
          <PushButton>
            <ObjectName>PlayButton</ObjectName><TooltipId>play_start_stop</TooltipId>
            <Size>0me,34max</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>&#9654; PLAY</Text></State>
            <State><Number>1</Number><Text>&#9646;&#9646; PAUSE</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="channel"/>],play</ConfigKey></Connection>
          </PushButton>

          <!-- Sep 1 -->
          <WidgetGroup><ObjectName>TS_Sep1</ObjectName><Layout>vertical</Layout><Size>7max,34max</Size><Children></Children></WidgetGroup>

          <!-- IN -->
          <PushButton>
            <ObjectName>LoopInButton</ObjectName><TooltipId>loop_in</TooltipId>
            <Size>0me,34max</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>IN</Text></State>
            <State><Number>1</Number><Text>IN</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="channel"/>],loop_in</ConfigKey></Connection>
          </PushButton>
          <Label><Size>3max,34max</Size></Label>
          <!-- OUT -->
          <PushButton>
            <ObjectName>LoopOutButton</ObjectName><TooltipId>loop_out</TooltipId>
            <Size>0me,34max</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>OUT</Text></State>
            <State><Number>1</Number><Text>OUT</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="channel"/>],loop_out</ConfigKey></Connection>
          </PushButton>
          <Label><Size>3max,34max</Size></Label>
          <!-- RELOOP -->
          <PushButton>
            <ObjectName>ReloopButton</ObjectName><TooltipId>reloop_toggle</TooltipId>
            <Size>0me,34max</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>RELOOP</Text></State>
            <State><Number>1</Number><Text>RELOOP</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="channel"/>],reloop_toggle</ConfigKey></Connection>
          </PushButton>

          <!-- Sep 2 -->
          <WidgetGroup><ObjectName>TS_Sep2</ObjectName><Layout>vertical</Layout><Size>7max,34max</Size><Children></Children></WidgetGroup>

          <!-- ÷2 -->
          <PushButton>
            <ObjectName>LoopHalveButton</ObjectName><TooltipId>loop_halve</TooltipId>
            <Size>0me,34max</Size><NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>&#247;2</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="channel"/>],loop_halve</ConfigKey></Connection>
          </PushButton>
          <Label><Size>2max,34max</Size></Label>
          <!-- Loop size -->
          <BeatSpinBox>
            <ObjectName>LoopSizeSpinBox</ObjectName><TooltipId>beatloop_size</TooltipId>
            <Size>0me,34max</Size>
            <Value>[Channel<Variable name="channel"/>],beatloop_size</Value>
          </BeatSpinBox>
          <Label><Size>2max,34max</Size></Label>
          <!-- ×2 -->
          <PushButton>
            <ObjectName>LoopDoubleButton</ObjectName><TooltipId>loop_double</TooltipId>
            <Size>0me,34max</Size><NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>&#215;2</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="channel"/>],loop_double</ConfigKey></Connection>
          </PushButton>

          <!-- Sep 3 -->
          <WidgetGroup><ObjectName>TS_Sep3</ObjectName><Layout>vertical</Layout><Size>7max,34max</Size><Children></Children></WidgetGroup>

          <!-- HI -->
          <PushButton>
            <ObjectName>KillHighButton</ObjectName><TooltipId>filterHighKill</TooltipId>
            <Size>0me,34max</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>HI</Text></State>
            <State><Number>1</Number><Text>HI</Text></State>
            <Connection><ConfigKey>[EqualizerRack1_[Channel<Variable name="channel"/>]_Effect1],button_parameter3</ConfigKey></Connection>
          </PushButton>
          <Label><Size>3max,34max</Size></Label>
          <!-- MID -->
          <PushButton>
            <ObjectName>KillMidButton</ObjectName><TooltipId>filterMidKill</TooltipId>
            <Size>0me,34max</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>MID</Text></State>
            <State><Number>1</Number><Text>MID</Text></State>
            <Connection><ConfigKey>[EqualizerRack1_[Channel<Variable name="channel"/>]_Effect1],button_parameter2</ConfigKey></Connection>
          </PushButton>
          <Label><Size>3max,34max</Size></Label>
          <!-- LOW -->
          <PushButton>
            <ObjectName>KillLowButton</ObjectName><TooltipId>filterLowKill</TooltipId>
            <Size>0me,34max</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>LOW</Text></State>
            <State><Number>1</Number><Text>LOW</Text></State>
            <Connection><ConfigKey>[EqualizerRack1_[Channel<Variable name="channel"/>]_Effect1],button_parameter1</ConfigKey></Connection>
          </PushButton>

          <!-- Sep 4 -->
          <WidgetGroup><ObjectName>TS_Sep4</ObjectName><Layout>vertical</Layout><Size>7max,34max</Size><Children></Children></WidgetGroup>

          <!-- PFL -->
          <PushButton>
            <ObjectName>PFLButton</ObjectName><TooltipId>pfl</TooltipId>
            <Size>0me,34max</Size><NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>&#9654;</Text></State>
            <State><Number>1</Number><Text>&#9654;</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="channel"/>],pfl</ConfigKey></Connection>
          </PushButton>
          <Label><Size>3max,34max</Size></Label>

          <!-- QUANTIZE -->
          <WidgetGroup>
            <ObjectName>QuantizeGroup</ObjectName>
            <Layout>vertical</Layout>
            <Size>0me,34max</Size>
            <Children>
              <Label><ObjectName>QuantizeLabel</ObjectName><Text>QUANTIZE</Text><Size>0me,14max</Size></Label>
              <PushButton>
                <ObjectName>QuantizeButton</ObjectName><TooltipId>quantize</TooltipId>
                <Size>0me,20max</Size><NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>1/4</Text></State>
                <State><Number>1</Number><Text>1/4</Text></State>
                <Connection><ConfigKey>[Channel<Variable name="channel"/>],quantize</ConfigKey></Connection>
              </PushButton>
            </Children>
          </WidgetGroup>

        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
